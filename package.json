{
  "name": "geosee-alpha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:pages": "node tools/validate-project-pages.mjs",
    "check:artifacts": "node tools/validate-artifact-metadata.mjs --project projects/utah-forge",
    "check:coverage": "node tools/report-project-artifact-coverage.mjs",
    "check:agent-drag": "node tools/check-agent-drag.mjs",
    "check:runtime-assets": "node tools/validate-runtime-assets.mjs",
    "check:utah-derived": "node tools/validate-utah-derived-assets.mjs",
    "check:utah-presentation": "node tools/validate-utah-presentation-baseline.mjs",
    "check:utah-runtime": "npm run check:runtime-assets && npm run check:utah-derived",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:utah-forge": "playwright test tests/utah-forge-smoke.spec.ts"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "geotiff": "^2.1.3",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "delaunator": "^5.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
