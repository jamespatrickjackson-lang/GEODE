+test("final transition commit lands target background and fog after full page apply", () => {
+  const sceneManager = readSource("src", "scene", "SceneManager.ts");
+
+  assert.match(
+    sceneManager,
+    /resolveBackgroundFogState/,
+    "SceneManager should resolve the target background/fog state for final landing.",
+  );
+  assert.match(
+    sceneManager,
+    /private\s+commitEnvironmentSceneTargetFrame\(\s*environment:\s*EnvironmentSetup,\s*page:\s*PresentationPage,?\s*\)/,
+    "SceneManager should expose a narrow final environment-scene landing helper.",
+  );
+  const helperBody = sceneManager.match(
+    /private\s+commitEnvironmentSceneTargetFrame\([\s\S]*?\n  \}/,
+  );
+  assert.ok(helperBody, "Final environment landing helper should be inspectable.");
+  assert.match(
+    helperBody[0],
+    /resolveCinematicSceneForTransition\(\s*environment,\s*page\s*\)/,
+    "Final landing should use the same resolved target scene as transition frames.",
+  );
+  assert.match(
+    helperBody[0],
+    /resolveBackgroundFogState\(/,
+    "Final landing should derive the exact target background/fog frame.",
+  );
+  assert.match(
+    helperBody[0],
+    /const frame:\s*EnvironmentSceneTransitionFrame\s*=\s*\{[\s\S]*progress:\s*1[\s\S]*done:\s*true[\s\S]*this\.applyEnvironmentSceneTransitionFrame\(\s*frame\s*\)/s,
+    "Final landing should apply a terminal background/fog frame.",
+  );
+
+  const finalizeStart = sceneManager.indexOf("finalizePageTransitionCommit(");
+  const finalizeEnd = sceneManager.indexOf(
+    "private transitionTweenEasedProgress(",
+    finalizeStart,
+  );
+  const finalizeBody =
+    finalizeStart >= 0 && finalizeEnd > finalizeStart
+      ? sceneManager.slice(finalizeStart, finalizeEnd)
+      : null;
+  assert.ok(finalizeBody, "Final commit body should be inspectable.");
+  const applyEnvironmentIndex = finalizeBody.indexOf(
+    "this.applyEnvironment(environment)",
+  );
+  const applyPageSceneIndex = finalizeBody.indexOf(
+    "this.applyPageScene(nextPage)",
+  );
+  const finalLandingIndex = finalizeBody.indexOf(
+    "this.commitEnvironmentSceneTargetFrame(environment, nextPage)",
+  );
+  assert.ok(
+    applyEnvironmentIndex >= 0,
+    "Final commit should still apply the full target environment.",
+  );
+  assert.ok(
+    applyPageSceneIndex > applyEnvironmentIndex,
+    "Final commit should apply the target page after the full environment.",
+  );
+  assert.ok(
+    finalLandingIndex > applyPageSceneIndex,
+    "The resolved target background/fog frame should be the final writer.",
+  );
+});
+
